{
  "enabledPlugins": {
    "CLI@klaviyo-plugins": true,
    "code-simplifier@claude-plugins-official": true,
    "codex@openai-codex": true,
    "gateway@klaviyo-plugins": true,
    "github@claude-plugins-official": true,
    "kl-storytime@klaviyo-plugins": true,
    "pagerduty@claude-plugins-official": false,
    "permissions-audit@klaviyo-plugins": true,
    "personal-voice@klaviyo-plugins": true,
    "plugin-dev@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pydantic-ai@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "repo": "ChromeDevTools/chrome-devtools-mcp",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "temporal-marketplace": {
      "source": {
        "repo": "temporalio/agent-skills",
        "source": "github"
      }
    },
    "tui-utils": {
      "autoUpdate": true,
      "source": {
        "repo": "jeffdt/tui-utils",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Purr.aiff",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.agents/scripts/backup-config.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/scripts/tmux-mux-nudge.sh",
            "if": "Bash(tmux *)",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash ~/.claude/scripts/gh-publish-guard.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/scripts/gh-publish-guard.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "mcp__plugin_github_github__pull_request_review_write|mcp__plugin_github_github__update_pull_request|mcp__plugin_github_github__create_pull_request"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.tmux/plugins/tmux-assistant-resurrect/hooks/claude-session-cleanup.sh\"",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.tmux/plugins/tmux-assistant-resurrect/hooks/claude-session-track.sh\"",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Hero.aiff",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
