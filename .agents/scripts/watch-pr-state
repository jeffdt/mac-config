#!/usr/bin/env bash
# One check of a PR, for `watch`: exit 0 reached the goal, 1 closed or failed,
# 3 still going. Any detail comes first; the last line is a short spoken
# outcome ("merged", "CI passed", "CI failed").
#
# usage: watch-pr-state [--until merged|ci] <pr-number>   (run inside a checkout of the PR's repo)
#
# --until merged (default) succeeds when the PR merges. --until ci succeeds
# when every CI check on the head commit has finished and none failed.
# Failure means closed without merging, the Trunk merge queue's newest state
# is Failed or Cancelled, or a CI check on the head commit failed. Repos
# without Trunk use only GitHub's state and checks.
set -uo pipefail

until=merged
[[ ${1:-} == --until ]] && { until=$2; shift 2; }
pr=${1:?usage: watch-pr-state [--until merged|ci] <pr-number>}
cd "$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "run it inside a checkout"; exit 2; }

case $(gh pr view "$pr" --json state -q .state 2>/dev/null) in
MERGED) echo "Merged"; exit 0 ;;
CLOSED) echo "Closed without merging"; exit 1 ;;
esac

# Trunk's status lists the PR's whole history; only the newest entry is its state now.
if [[ -f .trunk/trunk.yaml ]] && command -v trunk >/dev/null; then
	latest=$(trunk merge status "$pr" --no-progress 2>/dev/null |
		sed $'s/\x1b\\[[0-9;]*m//g' | grep -E '^ *[0-9]{2}-[0-9]{2} ' | tail -1 | sed -E 's/ +/ /g')
	if [[ $latest =~ Failed|Cancelled ]]; then
		echo "merge queue:$latest"
		echo "Failed the merge queue"
		exit 1
	fi
fi

checks=$(gh pr checks "$pr" --json name,bucket \
	-q '.[] | select(.name | startswith("Trunk Merge Queue") | not) | "\(.bucket)\t\(.name)"' 2>/dev/null)
failing=$(awk -F'\t' '$1 == "fail" {print $2}' <<<"$checks")
if [[ -n $failing ]]; then
	echo "failing checks: ${failing//$'\n'/, }"
	echo "CI failed"
	exit 1
fi

if [[ $until == ci && -n $checks ]] && ! grep -q '^pending' <<<"$checks"; then
	echo "CI passed"
	exit 0
fi

echo "still open${latest:+:$latest}"
exit 3
