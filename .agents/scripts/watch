#!/usr/bin/env bash
# Run a check command until it settles, then print its last output, loop a
# sound briefly, and speak what finished so parallel watches are told apart.
#
# usage: watch [-i poll-seconds] [-t timeout-seconds] -- <check command...>
#
# The check's exit code decides:  0  done, success (Glass)
#                                 1  done, failure (Basso)
#                                 anything else: still waiting, poll again
# A timeout counts as a failure. Exits with the check's final code (1 on
# timeout). WATCH_OK_SOUND, WATCH_BAD_SOUND and WATCH_SECONDS override the
# sounds and how long they loop (default 3 seconds). Then it speaks, in one
# voice, "Message from <tmux session>, <window>. Message: <last line>." (the
# prefix only inside tmux), so the check's last output line should be a short
# sentence saying what happened ("k-repo PR merged", "Rollout complete"). A
# line that looks machine-shaped (URLs, timestamps, hashes, IDs, over 80
# characters) is replaced with "Check succeeded" or "Check failed".
# WATCH_SAY=0 turns speech off.
set -uo pipefail

poll=90 timeout=0
while getopts "i:t:" opt; do
	case $opt in
	i) poll=$OPTARG ;;
	t) timeout=$OPTARG ;;
	*) exit 2 ;;
	esac
done
shift $((OPTIND - 1))
[[ ${1:-} == -- ]] && shift
(($#)) || { echo "usage: watch [-i poll] [-t timeout] -- <check command...>" >&2; exit 2; }

ok_sound=${WATCH_OK_SOUND:-/System/Library/Sounds/Glass.aiff}
bad_sound=${WATCH_BAD_SOUND:-/System/Library/Sounds/Basso.aiff}
loop_seconds=${WATCH_SECONDS:-3}

# True when a line reads well aloud: short, and free of URLs, ISO timestamps,
# long digit runs and mixed letter-digit tokens like pod hashes.
speakable() {
	local line=$1 words w
	((${#line} <= 80)) || return 1
	[[ $line =~ https?:// || $line =~ [0-9]{4}-[0-9]{2}-[0-9]{2}T || $line =~ [0-9]{6,} ]] && return 1
	read -ra words <<<"$line"
	for w in "${words[@]}"; do
		[[ ${#w} -ge 7 && $w =~ [0-9] && $w =~ [A-Za-z] ]] && return 1
	done
	return 0
}

alarm() {
	local end=$((SECONDS + loop_seconds))
	while ((SECONDS < end)); do afplay "$1"; done
	[[ ${WATCH_SAY:-1} == 0 ]] && return
	local where= message
	message=$(tail -n1 <<<"$output")
	if ! speakable "$message"; then
		[[ $1 == "$ok_sound" ]] && message="Check succeeded" || message="Check failed"
	fi
	[[ -n ${TMUX_PANE:-} ]] && where=$(tmux display-message -p -t "$TMUX_PANE" '#S, #W' 2>/dev/null)
	if [[ -n $where ]]; then
		say "Message from $where. Message: $message."
	else
		say "$message."
	fi
}

started=$SECONDS
while true; do
	output=$("$@" 2>&1)
	code=$?
	case $code in
	0) echo "$output"; alarm "$ok_sound"; exit 0 ;;
	1) echo "$output"; alarm "$bad_sound"; exit 1 ;;
	esac
	if ((timeout > 0 && SECONDS - started >= timeout)); then
		echo "$output"
		if ((timeout >= 60)); then
			output="timed out after $((timeout / 60)) minutes"
		else
			output="timed out after $timeout seconds"
		fi
		echo "$output"
		alarm "$bad_sound"
		exit 1
	fi
	sleep "$poll"
done
