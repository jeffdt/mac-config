<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jeff.agents-publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.agents/bin/publish-wrapper.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>WatchPaths</key>
  <array>
    <string>__HOME__/.agents/skills</string>
    <string>__HOME__/.agents/agents</string>
    <string>__HOME__/.agents/agent-prompts</string>
    <string>__HOME__/.agents/scripts</string>
    <string>__HOME__/.agents/commands</string>
    <string>__HOME__/.agents/workflows</string>
    <string>__HOME__/.agents/instructions</string>
  </array>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/.agents/.publish.launchd.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.agents/.publish.launchd.err</string>
</dict>
</plist>
